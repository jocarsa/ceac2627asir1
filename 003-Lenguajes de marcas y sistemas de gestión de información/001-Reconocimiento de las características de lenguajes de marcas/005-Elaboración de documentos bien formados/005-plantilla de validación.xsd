<?xml version="1.0" encoding="UTF-8"?>

<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

    <xs:element name="curriculum">
        <xs:complexType>
            <xs:sequence>

                <!-- DATOS PERSONALES -->
                <xs:element name="datos_personales">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="nombre" type="xs:string"/>
                            <xs:element name="apellidos" type="xs:string"/>

                            <xs:element name="emails">
                                <xs:complexType>
                                    <xs:sequence>
                                        <xs:element name="trabajo" type="xs:string"/>
                                        <xs:element name="personal" type="xs:string"/>
                                    </xs:sequence>
                                </xs:complexType>
                            </xs:element>

                        </xs:sequence>
                    </xs:complexType>
                </xs:element>

                <!-- EXPERIENCIA PROFESIONAL -->
                <xs:element name="experiencias">
                    <xs:complexType>
                        <xs:sequence>

                            <xs:element name="experiencia"
                                        minOccurs="0"
                                        maxOccurs="unbounded">
                                <xs:complexType>
                                    <xs:sequence>
                                        <xs:element name="empresa" type="xs:string"/>
                                        <xs:element name="cargo" type="xs:string"/>
                                        <xs:element name="inicio" type="xs:string"/>
                                        <xs:element name="final" type="xs:string"/>
                                    </xs:sequence>
                                </xs:complexType>
                            </xs:element>

                        </xs:sequence>
                    </xs:complexType>
                </xs:element>

              

            </xs:sequence>
        </xs:complexType>
    </xs:element>

</xs:schema>